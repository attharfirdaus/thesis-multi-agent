# Copy to .env for local development. Never commit .env.
ENV=development

# Runtime role: not the table owner, so row-level security applies.
DATABASE_URL=postgresql://thesis_app:app_local_pw@localhost:5432/thesis_dev
# Owner role, used only by scripts/migrate.py.
MIGRATION_DATABASE_URL=postgresql://thesis_migrator:migrator_local_pw@localhost:5432/thesis_dev

# Frontend origin(s) allowed to call this API with credentials.
ALLOWED_ORIGINS=["http://localhost:3000"]

SESSION_COOKIE_NAME=ta_session
CSRF_COOKIE_NAME=ta_csrf
SESSION_TTL_DAYS=14
# true on the real host (HTTPS), false for local http development only.
COOKIE_SECURE=false
# Blank for Cloud Run's default *.run.app host; set only when a custom domain is attached.
COOKIE_DOMAIN=
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_SECONDS=900

# =====================================================================
# Production (Google Cloud Run + Neon PostgreSQL)
# =====================================================================
# These are NOT put in a file on Cloud Run. Non-secret values are passed with
# `gcloud run deploy --set-env-vars` (see scripts/deploy-cloudrun.sh); real
# secrets (DATABASE_URL, later LLM_API_KEY) are injected from Google Secret
# Manager and never written to disk. This block documents the production
# values, it is not copied anywhere.
#
# ENV=production
# COOKIE_SECURE=true
# COOKIE_DOMAIN=            # blank for Cloud Run's default *.run.app host; set only for a custom domain
#
# Origin(s) of the deployed frontend. JSON list, exact scheme + host, no
# trailing slash. The frontend host is still an open item in DECISIONS.md.
# ALLOWED_ORIGINS=["https://<deployed-frontend-origin>"]
#
# App traffic goes through Neon's PgBouncer pooler: the host carries a
# `-pooler` segment. The URL must keep `sslmode=require`.
# DATABASE_URL=postgresql://thesis_app:<password>@ep-xxxx-pooler.ap-southeast-1.aws.neon.tech/thesis?sslmode=require
#
# Migrations use the DIRECT (no `-pooler`) URL: the pooler runs PgBouncer in
# transaction mode and does not support session-level state. Applied by
# `uv run python -m scripts.migrate` from a machine that can reach Neon,
# never from the container and never at container start.
# MIGRATION_DATABASE_URL=postgresql://thesis_migrator:<password>@ep-xxxx.ap-southeast-1.aws.neon.tech/thesis?sslmode=require

# --- Not used in phase 2, filled in at phase 4 (see DECISIONS.md) ---
# LLM_PROVIDER=cloudflare
# LLM_BASE_URL=https://api.cloudflare.com/client/v4/accounts/<account_id>/ai/v1
# LLM_MODEL=@cf/google/gemma-4-26b-a4b-it
# LLM_API_KEY=
# LLM_TEMPERATURE=0
# LLM_SEED=
